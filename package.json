{
  "name": "pursue-data-analyzer",
  "version": "0.11.14",
  "description": "Local-first desktop OSINT evidence analyzer for syncing, preserving, analyzing, searching, and exporting WAR.gov UFO/PURSUE records.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=24 <27",
    "bun": ">=1.3.9"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0205 vite dev",
    "build": "NODE_OPTIONS=--disable-warning=DEP0205 vite build",
    "preview": "vite preview",
    "check": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync && NODE_OPTIONS=--disable-warning=DEP0205 svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync && NODE_OPTIONS=--disable-warning=DEP0205 svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "downloads:validate": "node scripts/validate-download-profile.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "overrides": {
    "cookie": "^1.1.1",
    "brace-expansion": "5.0.12",
    "postcss-selector-parser": "7.1.6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "leaflet": "^1.9.4",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
