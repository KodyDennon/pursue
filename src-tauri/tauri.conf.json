{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PURSUE Data Analyzer",
  "version": "0.11.4",
  "identifier": "com.pursue-data-analyzer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PURSUE Data Analyzer",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "war-gov-resolver"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "licenseFile": "../src-tauri/license.txt",
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "headerImage": "../src-tauri/icons/header.bmp",
        "sidebarImage": "../src-tauri/icons/sidebar.bmp",
        "installerHooks": "../src-tauri/installer.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/models/**/*",
      "assets/pdfium/**/*",
      "assets/native_runtime/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3Q0FEMjY3RTU3MEQ4RjcKUldUMzJIRGxaOUxLSjRZR1oxOUpqWlNmbS90UGZSVFFIdVpKK216VEJtbHZmWjcxK2xTTjdwSEMK",
      "endpoints": [
        "https://downloads.kodydennon.com/latest.json",
        "https://github.com/KodyDennon/pursue/releases/latest/download/latest.json"
      ]
    }
  }
}
